rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 本人確認関数
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // テキスト検証関数
    function isValidText() {
      return request.resource.data.text is string
             && request.resource.data.text.size() > 0
             && request.resource.data.text.size() < 20000;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /checkout_sessions/{id} {
        allow read, write: if isOwner(userId);
      }
      match /system/{docId} {
        allow read: if isOwner(userId);
      }
    }

    match /memories/{memoryId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidText();
      allow update: if isOwner(resource.data.userId) && isValidText();
    }

    match /chat_logs/{logId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
    }

    // ★修正: ToDoリストへの読み書き権限を追加
    match /todos/{todoId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId);
    }

    // ★修正: 日刊レポートへの読み書き権限を追加
    match /daily_reports/{reportId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId);
    }
  }
}