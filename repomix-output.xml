<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Brain - あなただけの第2の脳</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=Poppins:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        /* My Brain 用のカラーパレット */
        --primary: #3b82f6; /* Blue 500 */
        --primary-light: #60a5fa; /* Blue 400 */
        --dark: #0f172a; /* Slate 900 */
        --darker: #020617; /* Slate 950 */
        --light: #f8fafc; /* Slate 50 */
        --accent: #8b5cf6; /* Violet 500 */
        --text-gray: #94a3b8;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", "Noto Sans JP", sans-serif;
        background-color: var(--darker);
        color: var(--light);
        overflow-x: hidden; /* 横スクロール禁止 */
      }

      /* スライドコンテナ */
      .slides-container {
        width: 100vw;
        height: 100vh;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
      }

      /* 個別スライド */
      section {
        width: 100vw;
        height: 100vh;
        scroll-snap-align: start;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        overflow: hidden;
      }

      /* 背景装飾 */
      .bg-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.2;
        z-index: 0;
      }

      /* タイポグラフィ */
      h1 {
        font-size: clamp(2.5rem, 6vw, 5rem);
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, #fff 0%, var(--primary-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-align: center;
        z-index: 1;
      }

      h2 {
        font-size: clamp(1.5rem, 4vw, 3rem);
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-bottom: 2rem;
        text-align: center;
        z-index: 1;
      }

      h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: white;
      }

      p {
        font-size: 1.2rem;
        color: var(--text-gray);
        max-width: 800px;
        text-align: center;
        line-height: 1.8;
        z-index: 1;
      }

      /* アニメーション用クラス */
      .fade-in-up {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease-out;
      }

      section.active .fade-in-up {
        opacity: 1;
        transform: translateY(0);
      }

      /* 遅延設定 */
      .delay-100 {
        transition-delay: 0.1s;
      }
      .delay-200 {
        transition-delay: 0.2s;
      }
      .delay-300 {
        transition-delay: 0.3s;
      }
      .delay-500 {
        transition-delay: 0.5s;
      }

      /* パルスアニメーション */
      @keyframes pulse {
        0% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
        100% {
          transform: scale(1);
        }
      }
      .pulse-badge {
        animation: pulse 2s infinite;
      }

      /* --- ビジュアル要素 --- */

      /* スマホモック */
      .phone {
        width: 280px;
        height: 580px;
        background: #0f172a;
        border-radius: 40px;
        border: 8px solid #334155;
        position: relative;
