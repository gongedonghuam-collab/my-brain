        apiKey,
        [{ text: verifyPrompt }],
        true,
      );
      const verifyJson = JSON.parse(extractJson(verifyRes));
      const validIndices: number[] = verifyJson.indices || [];
      return uniqueCandidates.filter((_, i) => validIndices.includes(i));
    } catch (e) {
      console.error("Search Error:", e);
