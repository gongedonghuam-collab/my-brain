          e.preventDefault();
          container.scrollBy({ top: window.innerHeight, behavior: "smooth" });
        } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
          e.preventDefault();
          container.scrollBy({ top: -window.innerHeight, behavior: "smooth" });
        }
      });
