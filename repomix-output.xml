        @openDetail="onOpenDetail"
      />

      <ChatList v-if="inputMode === 'chat'" />
    </main>

    <MemoryModal :memory="editingMemory" @close="editingMemory = null" />

    <InputFooter :modelValue="inputMode" @update:modelValue="onModeChange" />
  </div>
</template>

