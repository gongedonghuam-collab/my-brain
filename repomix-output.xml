import type { CalendarOptions } from "@fullcalendar/core";

const GOOGLE_CALENDAR_COLORS: Record<string, string> = {
  "1": "#7986cb",
  "2": "#33b679",
  "3": "#8e24aa",
  "4": "#e67c73",
