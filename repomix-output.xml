  initAuth();
  initTheme(); // テーマ監視開始
});

onUnmounted(() => {
  cleanupTheme();
});

watch(currentUser, (newUser) => {
  if (newUser === null) {
    const publicPages = ["/", "/login", "/legal", "/verify-email", "/privacy"];
    if (!publicPages.includes(router.currentRoute.value.path)) {
      router.push("/login");
    }
  }
});
</script>

